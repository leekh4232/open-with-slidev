{
  "name": "open-with-slidev",
  "displayName": "Open with Slidev",
  "description": "마크다운 파일을 우클릭 → 'Open with Slidev' 로 바로 Slidev 슬라이드를 띄운다. Slidev 가 없으면 처음 한 번 전역으로 설치해 주고(저장소마다 node_modules 를 만들지 않음), 내장 테마 32종을 이름만으로, 테마 폴더는 경로로 쓸 수 있다. 'Build with Slidev' 하위 메뉴로 서버 없이 열리는 HTML 한 파일, PDF, PPTX, PNG, Markdown 으로 내보낸다.",
  "version": "0.8.2",
  "publisher": "leekh",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openWithSlidev.open",
        "title": "Open with Slidev",
        "category": "Slidev"
      },
      {
        "command": "openWithSlidev.build",
        "title": "HTML (.html, 서버 없이 열리는 한 파일)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.export.pdf",
        "title": "PDF (.pdf)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.export.pptx",
        "title": "PowerPoint (.pptx)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.export.png",
        "title": "PNG (슬라이드별 이미지 폴더)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.export.md",
        "title": "Markdown (.md + 슬라이드 PNG)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.teacher.hossam",
        "title": "hossam build (강사명 이광호 · HTML + 비밀번호 PDF)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.teacher.jussam",
        "title": "jussam build (강사명 주영아 · HTML + 비밀번호 PDF)",
        "category": "Build with Slidev"
      },
      {
        "command": "openWithSlidev.downloadThemes",
        "title": "내장 테마 미리 내려받기",
        "category": "Slidev"
      }
    ],
    "submenus": [
      {
        "id": "openWithSlidev.buildMenu",
        "label": "Build with Slidev"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown && openWithSlidev.matches",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == markdown && openWithSlidev.matches",
          "group": "navigation@2",
          "submenu": "openWithSlidev.buildMenu"
        }
      ],
      "editor/title/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == markdown",
          "group": "navigation@2",
          "submenu": "openWithSlidev.buildMenu"
        }
      ],
      "explorer/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation@2",
          "submenu": "openWithSlidev.buildMenu"
        }
      ],
      "openWithSlidev.buildMenu": [
        {
          "command": "openWithSlidev.build",
          "group": "1_html@1"
        },
        {
          "command": "openWithSlidev.export.pdf",
          "group": "2_export@1"
        },
        {
          "command": "openWithSlidev.export.pptx",
          "group": "2_export@2"
        },
        {
          "command": "openWithSlidev.export.png",
          "group": "2_export@3"
        },
        {
          "command": "openWithSlidev.export.md",
          "group": "2_export@4"
        },
        {
          "command": "openWithSlidev.teacher.hossam",
          "when": "openWithSlidev.teacherMode",
          "group": "3_teacher@1"
        },
        {
          "command": "openWithSlidev.teacher.jussam",
          "when": "openWithSlidev.teacherMode",
          "group": "3_teacher@2"
        }
      ]
    },
    "configuration": {
      "title": "Open with Slidev",
      "properties": {
        "openWithSlidev.previewIn": {
          "type": "string",
          "enum": [
            "browser",
            "vscode"
          ],
          "default": "browser",
          "enumDescriptions": [
            "외부 브라우저에서 연다 (slidev --open)",
            "VS Code 안 Simple Browser 탭을 편집기 옆에 연다"
          ],
          "description": "슬라이드를 어디에 띄울지"
        },
        "openWithSlidev.command": {
          "type": "string",
          "default": "node \"${slidev}\" \"${file}\"",
          "description": "실행 명령. ${slidev} = 쓸 Slidev 실행 파일(프로젝트의 node_modules/@slidev/cli 가 있으면 그것, 없으면 전역 설치의 bin/slidev.mjs), ${file} = 프로젝트 루트 기준 md 상대 경로, ${root} = 프로젝트 루트. 포트·--open·테마·extraArgs 는 뒤에 자동으로 붙는다. 비우면 기본값. 직접 바꾸면 그 명령을 그대로 쓴다. 예: pnpm exec slidev \"${file}\""
        },
        "openWithSlidev.slidevPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "전역 Slidev 의 @slidev/cli 패키지 폴더 (예: /opt/homebrew/lib/node_modules/@slidev/cli). 비우면 처음 실행 때 자동으로 찾아(npm root -g, PATH 의 slidev) 여기에 기록하고, 없으면 터미널에서 npm install -g @slidev/cli @slidev/theme-default 로 설치한 뒤 기록한다. 프로젝트에 로컬 Slidev(node_modules/@slidev/cli)가 있으면 그것을 먼저 쓴다"
        },
        "openWithSlidev.extraArgs": {
          "type": "string",
          "default": "",
          "description": "명령 끝에 덧붙일 인자. 예: --remote (다른 기기에서 보기), --log info"
        },
        "openWithSlidev.onRerun": {
          "type": "string",
          "enum": [
            "focus",
            "restart"
          ],
          "default": "focus",
          "enumDescriptions": [
            "이미 띄운 터미널을 보여 준다",
            "서버를 끄고 다시 띄운다"
          ],
          "description": "같은 파일에서 다시 실행했을 때"
        },
        "openWithSlidev.port": {
          "type": "number",
          "default": 3030,
          "minimum": 1024,
          "maximum": 65535,
          "description": "시작 포트. 다른 프로그램이 쓰고 있으면 다음 번호를 자동으로 찾는다 (3031, 3032 …). 서버는 한 번에 하나만 띄우며, 다른 md 를 열면 이전 서버를 끄고 새로 띄운다"
        },
        "openWithSlidev.projectRoot": {
          "type": "string",
          "default": "",
          "description": "프로젝트 루트. md 상대 경로와 테마 경로의 기준이고, 여기(또는 위쪽)의 node_modules/@slidev/cli 가 있으면 그것으로 실행한다. 비우면 md 파일 위쪽에서 Slidev 가 설치된 폴더를 찾고, 없으면 워크스페이스 폴더(없으면 md 폴더). 절대 경로 또는 워크스페이스 기준 상대 경로"
        },
        "openWithSlidev.defaultTheme": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "default",
            "seriph",
            "apple-basic",
            "bricks",
            "shibainu",
            "geist",
            "light-icons",
            "eloc",
            "purplin",
            "unicorn",
            "zhozhoba",
            "penguin",
            "vuetiful",
            "takahashi",
            "academic",
            "mokkapps",
            "the-unnamed",
            "dracula",
            "frankfurt",
            "hep",
            "excali-slide",
            "mint",
            "neversink",
            "nord",
            "scholarly",
            "field-manual",
            "touying",
            "tahta",
            "terminal",
            "bestony2026",
            "zhibai",
            "legible"
          ],
          "enumDescriptions": [
            "지정 안 함 (Slidev 기본 동작)",
            "[공식] Default — Slidev 기본 테마. 미니멀, 라이트/다크",
            "[공식] Seriph — 세리프 글꼴의 격식 있는 테마",
            "[공식] Apple Basic — Apple Keynote 의 Basic Black/White 느낌",
            "[공식] Bricks — 벽돌 느낌의 블록 레이아웃",
            "[공식] Shibainu — 시바견 일러스트의 귀여운 테마",
            "[갤러리] Vercel (Geist) — Vercel 디자인 시스템 기반, 검정·흰색",
            "[갤러리] Light Icons — 밝고 단정한 테마, 창의적인 레이아웃과 아이콘",
            "[갤러리] Eloc — 글쓰기에 집중한 간결한 발표 스타일",
            "[갤러리] Purplin — 보라색 기반, 하단 바 컴포넌트",
            "[갤러리] Unicorn — Dawntraoz 웹사이트 디자인 기반",
            "[갤러리] Zhozhoba — Zhozhoba 스타일 테마",
            "[갤러리] Penguin — 펭귄 테마, 라이트/다크",
            "[갤러리] Vuetiful — Vue 색감의 테마",
            "[갤러리] Takahashi — 큰 글자 몇 개로만 말하는 타카하시 기법",
            "[갤러리] Academic — 학술 발표용, 간단한 구성",
            "[갤러리] Mokkapps — Mokkapps 브랜드 테마",
            "[갤러리] The unnamed — VS Code 'The unnamed' 테마 색감",
            "[갤러리] Dracula — Dracula 다크 색상 테마",
            "[갤러리] Frankfurt — LaTeX Beamer Frankfurt 스타일",
            "[갤러리] HEP — 고에너지물리 학술 발표 스타일",
            "[갤러리] Excali-slide — Excalidraw 손그림 느낌, 형광펜 강조 애니메이션",
            "[갤러리] Mint — 민트색 테마",
            "[갤러리] Neversink — 아이콘·QR·다양한 레이아웃이 풍부한 테마",
            "[갤러리] Nord — Nord 색상 팔레트",
            "[갤러리] Scholarly — Nord 기반 학술 테마, 인용·참고문헌 지원",
            "[갤러리] Field Manual — 빈티지 군용 매뉴얼 스타일, 레이아웃 24개",
            "[갤러리] Touying — Typst Touying 디자인 기반",
            "[갤러리] Tahta — 디자인 토큰 기반, 스타일 변형 13종",
            "[추천] Terminal — 터미널 창 스타일, 셸 프롬프트, 색 구성 3종 (코딩 강의에 적합)",
            "[추천] Crimson Deck — 검정 바탕 크림슨 강조, 레이아웃 27개와 ECharts 차트",
            "[추천] Zhibai — 종이·먹 느낌의 편집 디자인, 프리셋 5종",
            "[추천] Legible — 슬라이드당 주장 하나(Assertion-Evidence), 큰 글씨"
          ],
          "description": "md 프런트매터에 theme 가 없을 때 쓸 테마. 기본은 지정 안 함(Slidev 기본 동작). 처음 쓸 때 npm 에서 내려받아 캐시에 둔다. 프런트매터의 theme 가 우선"
        },
        "openWithSlidev.defaultThemePath": {
          "type": "string",
          "default": "",
          "description": "내장 목록에 없는 기본 테마를 쓸 때: 폴더 경로(절대 또는 프로젝트 루트 기준) 또는 npm 테마 이름. 값이 있으면 defaultTheme 드롭다운보다 우선"
        },
        "openWithSlidev.openPresenter": {
          "type": "boolean",
          "default": false,
          "description": "발표자 모드(/presenter)도 외부 브라우저로 함께 연다"
        },
        "openWithSlidev.filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md"
          ],
          "description": "우클릭 메뉴를 보일 파일(glob, 워크스페이스 기준). 예: [\"**/*.nb.md\", \"slides/**/*.md\"]. 폴더 없이 쓰면 파일 이름만 비교한다"
        },
        "openWithSlidev.stopOnClose": {
          "type": "boolean",
          "default": false,
          "description": "md 편집기를 닫으면 그 파일의 Slidev 서버(터미널)도 끈다"
        },
        "openWithSlidev.teacherMode": {
          "type": "boolean",
          "default": false,
          "description": "켜면 Build with Slidev 하위 메뉴 끝에 구분선과 함께 'hossam build'·'jussam build'가 보인다. 둘 다 md 의 강사명 자리('{teacher}' 또는 상대 강사 이름)를 해당 강사 이름으로 바꿔 복사본으로 빌드하고(원본은 그대로), HTML 한 파일과 비밀번호가 걸린 PDF 를 slides.hossam.html·slides.hossam.pdf 처럼 만든다. PDF 비밀번호는 qpdf 로 거는데, 처음 한 번 qpdf-wasm 을 캐시에 내려받는다"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leekh4232/open-with-slidev.git"
  },
  "homepage": "https://open-with-slidev.hossam.kr/",
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@vscode/vsce": "^3"
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ]
}
