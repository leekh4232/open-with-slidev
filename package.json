{
  "name": "open-with-slidev",
  "displayName": "Open with Slidev",
  "description": "마크다운 파일을 우클릭 → 'Open with Slidev' 로 바로 Slidev 슬라이드를 띄운다. 프로젝트에 Slidev 가 없어도 동작한다.",
  "version": "0.1.1",
  "publisher": "leekh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openWithSlidev.open",
        "title": "Open with Slidev",
        "category": "Slidev"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown && openWithSlidev.matches",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceExtname == .md",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Open with Slidev",
      "properties": {
        "openWithSlidev.previewIn": {
          "type": "string",
          "enum": [
            "browser",
            "vscode"
          ],
          "default": "browser",
          "enumDescriptions": [
            "외부 브라우저에서 연다 (slidev --open)",
            "VS Code 안 Simple Browser 탭을 편집기 옆에 연다"
          ],
          "description": "슬라이드를 어디에 띄울지"
        },
        "openWithSlidev.command": {
          "type": "string",
          "default": "npx slidev \"${file}\"",
          "description": "실행 명령. ${file} = 프로젝트 루트 기준 md 상대 경로, ${root} = 프로젝트 루트. 포트·--open·테마·extraArgs 는 뒤에 자동으로 붙는다. 비우거나 기본값이면 Slidev 가 설치된 폴더에서는 npx slidev, 없으면 npx -p @slidev/cli … 로 내려받아 실행. 예: slidev \"${file}\" (전역 설치), pnpm exec slidev \"${file}\""
        },
        "openWithSlidev.extraArgs": {
          "type": "string",
          "default": "",
          "description": "명령 끝에 덧붙일 인자. 예: --remote (다른 기기에서 보기), --log info"
        },
        "openWithSlidev.onRerun": {
          "type": "string",
          "enum": [
            "focus",
            "restart"
          ],
          "default": "focus",
          "enumDescriptions": [
            "이미 띄운 터미널을 보여 준다",
            "서버를 끄고 다시 띄운다"
          ],
          "description": "같은 파일에서 다시 실행했을 때"
        },
        "openWithSlidev.port": {
          "type": "number",
          "default": 3030,
          "minimum": 1024,
          "maximum": 65535,
          "description": "시작 포트. 사용 중이면 다음 번호를 자동으로 찾는다 (덱마다 3030, 3031, …)"
        },
        "openWithSlidev.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Slidev 가 설치된 폴더(node_modules/.bin/slidev 가 있는 곳). 비우면 md 파일 위쪽으로 자동 탐색하고, 없으면 npx 가 Slidev 를 내려받아 실행한다. 절대 경로 또는 워크스페이스 기준 상대 경로"
        },
        "openWithSlidev.defaultTheme": {
          "type": "string",
          "default": "",
          "description": "md 프런트매터에 theme 가 없을 때 쓸 테마. 폴더 경로(절대 또는 프로젝트 루트 기준) 또는 테마 이름(예: seriph). 프런트매터에 theme 가 있으면 그것이 우선"
        },
        "openWithSlidev.openPresenter": {
          "type": "boolean",
          "default": false,
          "description": "발표자 모드(/presenter)도 외부 브라우저로 함께 연다"
        },
        "openWithSlidev.filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md"
          ],
          "description": "우클릭 메뉴를 보일 파일(glob, 워크스페이스 기준). 예: [\"**/*.nb.md\", \"slides/**/*.md\"]. 폴더 없이 쓰면 파일 이름만 비교한다"
        },
        "openWithSlidev.stopOnClose": {
          "type": "boolean",
          "default": false,
          "description": "md 편집기를 닫으면 그 파일의 Slidev 서버(터미널)도 끈다"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leekh4232/open-with-slidev.git"
  },
  "devDependencies": {
    "@vscode/vsce": "^3"
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ]
}
