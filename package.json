{
  "name": "open-with-slidev",
  "displayName": "Open with Slidev",
  "description": "마크다운 편집기나 탐색기에서 우클릭 → 'Open with Slidev' 로 현재 md 파일을 Slidev 로 띄운다 (Live Preview 의 Show Preview 처럼).",
  "version": "0.1.0",
  "publisher": "leekh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openWithSlidev.open",
        "title": "Open with Slidev",
        "category": "Slidev"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "openWithSlidev.open",
          "when": "resourceExtname == .md",
          "group": "navigation@1"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leekh4232/open-with-slidev.git"
  }
}
